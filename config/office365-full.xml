<!--
  Office 365 ProPlus - Full installation (64-bit)

  Installs the complete Office 365 suite:
  Word, Excel, PowerPoint, Outlook, OneNote, Access, Publisher

  Notes:
  - Teams and OneDrive are excluded because they are now
    installed as separate applications.
  - Channel: Current (most up-to-date feature set).
-->
<Configuration>
  <Add OfficeClientEdition="64" Channel="Current" ForceUpgrade="True" MigrateArch="True">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
      <ExcludeApp ID="Groove" />
      <ExcludeApp ID="OneDrive" />
      <ExcludeApp ID="Teams" />
    </Product>
  </Add>
  <Display Level="Full" AcceptEULA="TRUE" />
  <Updates Enabled="TRUE" />
  <RemoveMSI />
</Configuration>