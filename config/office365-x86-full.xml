<!--
  Office 365 ProPlus - Full installation (32-bit)

  Same as office365-full.xml but for 32-bit systems.
-->
<Configuration>
  <Add OfficeClientEdition="32" Channel="Current" ForceUpgrade="True" MigrateArch="True">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
      <ExcludeApp ID="Groove" />
      <ExcludeApp ID="OneDrive" />
      <ExcludeApp ID="Teams" />
    </Product>
  </Add>
  <Display Level="Full" AcceptEULA="TRUE" />
  <Updates Enabled="TRUE" />
  <RemoveMSI />
</Configuration>